# =================================================================
# SmartQueue OPD - Hospital Queue Management Configuration
# =================================================================
# Copy this file to .env before starting the server.
# Never commit real secrets or credentials to source control.

# Server Port (default: 3000)
PORT=3000

# Environment mode: development | production
NODE_ENV=development

# =================================================================
# Problem 1: Database Persistence & Storage Configuration
# =================================================================
# Path to SQLite database file.
# On Render with a Persistent Disk mounted at /var/data, set:
# SQLITE_DB_PATH=/var/data/smartqueue.db
# (If omitted, defaults to app/data/smartqueue.db)
# SQLITE_DB_PATH=./data/smartqueue.db

# Or configure the data directory:
# DATA_DIR=./data
# SQLITE_BACKUP_DIR=./data/backups

# =================================================================
# Problem 2: Secure Staff Authentication Configuration
# =================================================================
# Clinical Physician Credentials (EHR access, patient chart, call next)
STAFF_CLINICAL_USERNAME=dr.jenkins
STAFF_CLINICAL_PASSWORD=ClinicalDoc#2026

# Gate Security Staff Credentials (Zero-Knowledge 30-day QR validation)
STAFF_SECURITY_USERNAME=officer.briggs
STAFF_SECURITY_PASSWORD=GateSecurity#2026

# Session Security: Secret key for signing HMAC-SHA256 staff session tokens
# In production, set this to a high-entropy 64-character random string:
STAFF_SESSION_SECRET=smartqueue-secure-hmac-sha256-signing-secret-change-in-prod-2026

# Session duration in hours (default: 8)
STAFF_SESSION_HOURS=8

# Legacy / Machine-to-machine API Bearer Tokens (Automated test suites & background agents)
SECURITY_AUTH_TOKEN=sec-gate-token-402
CLINICAL_AUTH_TOKEN=cln-med-token-104

# =================================================================
# Frontend & CORS Configuration
# =================================================================
# Allowed external origins (comma-separated or single URL)
ALLOWED_ORIGIN=https://smartqueue-fsp.netlify.app

# Optional API base URL for frontend build (if frontend is hosted on separate domain like Netlify)
# VITE_API_URL=https://smartqueue-rrys.onrender.com/api

# Suppress Vite native config loader warnings in newer Node/Vite releases
VITE_CONFIG_NATIVE_IGNORE_WARNING=true
