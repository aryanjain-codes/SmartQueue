# =================================================================
# SmartQueue OPD - Hospital Queue Management Demo Configuration
# =================================================================
# Copy this file to .env before starting the server in custom environments.
# Never commit real secrets or credentials to source control.

# Server Port (default: 3000)
PORT=3000

# Environment mode: development | production
NODE_ENV=development

# Staff Authentication Bearer Tokens (Demo synthetic credentials)
# Used for role-based access control (RBAC) separation between clinical and security staff.
SECURITY_AUTH_TOKEN=sec-gate-token-402
CLINICAL_AUTH_TOKEN=cln-med-token-104

# Suppress Vite native config loader warnings in newer Node/Vite releases
VITE_CONFIG_NATIVE_IGNORE_WARNING=true
